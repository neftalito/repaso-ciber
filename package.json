{
  "name": "ic2026-estudio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Práctica estática de IC 2026. Sin dependencias de ejecución ni compilación.",
  "scripts": {
    "start": "python3 -m http.server 8080 --bind 127.0.0.1",
    "test": "node tests/content.test.js && node tests/progress.test.mjs",
    "test:dom": "node --experimental-vm-modules tests/dom.mjs",
    "test:browser": "node tests/browser.mjs",
    "extract": "python3 scripts/extract_questions.py",
    "validate": "python3 scripts/validate_data.py"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "jsdom": "29.1.1"
  }
}
